{
  "name": "voidroute",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "imports": {
    "#open-sse/*": "./open-sse/*",
    "#*": "./src/*"
  },
  "scripts": {
    "start": "bun run index.js",
    "test": "bun test",
    "codex:patch-desktop": "bun run tools/patch-codex-desktop.mjs --launch",
    "codex:launch": "bun run tools/launch-codex-desktop.mjs",
    "test:transport": "bun test test-transport.test.mjs",
    "check:syntax": "bun --check src/server/request-body.js && bun --check src/server/transport.js && bun --check src/shared/utils/redaction.js && bun --check open-sse/utils/requestLogger.js && bun --check open-sse/handlers/chatCore/requestDetail.js && bun --check open-sse/utils/usageTracking.js && bun --check src/lib/db/repos/usageWrite.js"
  },
  "dependencies": {
    "@inquirer/search": "4.2.1",
    "bcryptjs": "^2.4.3",
    "chalk": "^5.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "figlet": "1.11.0",
    "inquirer": "^9.2.22",
    "jose": "^5.6.3",
    "module-alias": "^2.2.3",
    "node-forge": "^1.3.1",
    "node-machine-id": "^1.1.12",
    "open": "11.0.0",
    "open-sse": "file:open-sse",
    "sql.js": "^1.14.1",
    "undici": "^6.19.2",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "playwright": "1.60.0"
  }
}
